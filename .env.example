# ── Database ─────────────────────────────────────────────────────────────
# Neon free tier. On Vercel this uses Neon's serverless HTTP driver, which
# cannot exhaust a connection pool.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ── Resend (one account for both sending and receiving) ──────────────────
RESEND_API_KEY="re_xxxxxxxx"
# From the Resend dashboard: Webhooks > create an email.received endpoint.
# Looks like whsec_...
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxx"

# The outbound envelope address. The domain must be verified in Resend
# (DNS records are in the README).
MAIL_FROM="relay@yourdomain.com"
MAIL_FROM_NAME="Relay"
# The receiving domain. Reply-To is written as reply+<token>@this-domain.
# Use the ROOT domain: once Receiving is enabled, the MX record Resend gives
# you sits on the zone apex, not on an inbound. subdomain. Get this wrong and
# no reply is ever received.
INBOUND_DOMAIN="yourdomain.com"

# ── Notifications ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
# Fallback notification mailbox. Must differ from both the sender and the
# receiver - /api/send rejects the request when it matches either of them.
DEFAULT_NOTIFY_EMAIL="ops@yourdomain.com"

# ── Filtering ────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-proj-xxxxxxxx"
# Turn this off to run the Stage 1 wordlist only. The chain still works end to
# end, which is enough for a demo and costs nothing.
FILTER_STAGE2_ENABLED="true"
# Allow the message through when Stage 2 times out or errors (keeping only the
# Stage 1 result). Set false to block instead.
FILTER_FAIL_OPEN="true"

# ── Everything else ──────────────────────────────────────────────────────
# Static password for the /admin view and the ?view=admin endpoints
ADMIN_TOKEN="pick-a-long-random-string"
# Password for the sender view. Optional: falls back to ADMIN_TOKEN when unset,
# so the sender view is never accidentally left open. Set it to something
# DIFFERENT from ADMIN_TOKEN in production - anyone who has ADMIN_TOKEN can also
# open the admin view and read the messages the filter held back.
APP_TOKEN="pick-another-long-random-string"
APP_URL="http://localhost:3000"
