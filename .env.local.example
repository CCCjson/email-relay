# Values for local development: no domain, no DNS, no real accounts.
# Copy this to .env and the whole chain works - send, reply, filter, notify -
# with mail going through the local mock.
DATABASE_URL="postgresql://relay:relay@localhost:55432/relay"
RESEND_API_KEY="re_local_dev"
