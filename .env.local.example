RESEND_BASE_URL="http://localhost:4010"
MAIL_FROM="relay@example.test"
MAIL_FROM_NAME="Relay"
INBOUND_DOMAIN="inbound.example.test"
SLACK_WEBHOOK_URL="http://localhost:4010/mock/slack"
DEFAULT_NOTIFY_EMAIL="ops@example.test"
OPENAI_API_KEY=""
FILTER_STAGE2_ENABLED="false"
FILTER_FAIL_OPEN="true"
ADMIN_TOKEN="local-admin-token"
APP_TOKEN="local-app-token"
APP_URL="http://localhost:3000"
